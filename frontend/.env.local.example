# ─────────────────────────────────────────────────────────────
# frontend/.env.local.example
#
# Copy to frontend/.env.local and edit. NEVER commit .env.local.
#   Windows PowerShell : Copy-Item frontend\.env.local.example frontend\.env.local
#   macOS / Linux      : cp frontend/.env.local.example frontend/.env.local
#
# NOTE: In Next.js, only variables prefixed NEXT_PUBLIC_ are readable from
# browser code. Everything the frontend needs is browser-side, so all of
# these are NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend, with NO trailing slash.
#   Local dev          : http://localhost:8000
#   Deployed (Aug 15)  : https://<your-hf-username>-silent-codriver.hf.space
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── THE FLAG THAT UNBLOCKS LANE C ────────────────────────────
# 1 → the app never calls the network. Every component renders from
#     src/lib/mock.ts. Lane C can build the entire UI before the backend
#     exists, on a laptop with no Python installed at all.
# 0 → real fetches against NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_USE_MOCKS=1

# Show a small dev-only banner stating whether mocks are on.
# Set to 0 before recording the demo video and before deploying.
NEXT_PUBLIC_SHOW_DEV_BANNER=1
