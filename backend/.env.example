# ─────────────────────────────────────────────────────────────
# backend/.env.example
#
# Copy this file to backend/.env and edit. NEVER commit backend/.env.
#   Windows PowerShell : Copy-Item backend\.env.example backend\.env
#   macOS / Linux      : cp backend/.env.example backend/.env
#
# Every value below has a working default in app/config.py, so an empty
# .env still boots. You only need to set things you want to change.
# ─────────────────────────────────────────────────────────────

# ── THE ONE FLAG THAT MATTERS FOR PARALLEL WORK ──────────────
# MOCK_ML=1  → all ML services return deterministic fake data.
#              No torch, no transformers, no model downloads, no GPU.
#              Server boots in <2 seconds.
#              *** Lane B and Lane C must use MOCK_ML=1 all day. ***
# MOCK_ML=0  → real models load lazily on first use (~2.5 GB download once).
#              Only Lane A needs this.
MOCK_ML=1

# ── Device selection ─────────────────────────────────────────
# auto | cuda | mps | cpu
#   auto → cuda if available, else mps (Apple Silicon), else cpu
#   Lane A (RTX 5070 Ti) should get cuda. See docs/SETUP.md for the
#   Blackwell/cu128 trap — a wrong torch build silently falls back to cpu.
DEVICE=auto

# ── Model IDs (all from the Hugging Face Hub) ────────────────
# Do NOT swap these casually — docs/IMPLEMENTATION.md explains why each
# was chosen, and ASR_MODEL_ID in particular must support word timestamps.
ASR_MODEL_ID=openai/whisper-small
EMOTION_MODEL_ID=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim

# Optional P2 text head. Leave blank to disable.
# TEXT_SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
TEXT_SENTIMENT_MODEL_ID=

# ── Paths (relative to repo root) ────────────────────────────
DATA_DIR=data
CLIPS_DIR=data/clips
LAPS_DIR=data/laps
CACHE_FILE=data/cache/analyses.json
METADATA_CSV=data/metadata.csv
LABELS_CSV=data/labels.csv
UPLOADS_DIR=data/uploads
FASTF1_CACHE_DIR=backend/.fastf1_cache

# ── Upload limits for POST /api/analyze ──────────────────────
MAX_UPLOAD_MB=15
MAX_AUDIO_SECONDS=60

# ── CORS: which frontend origins may call this API ───────────
# Comma-separated. Add your Vercel URL here before deploying (Aug 15).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── HuggingFace token ────────────────────────────────────────
# NOT required — every model we use is public. Only set this if you hit
# rate limits while downloading weights.
HF_TOKEN=

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
